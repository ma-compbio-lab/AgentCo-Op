# Container build for the Seurat case-study-2 wrapper. Generated to
# match `case_study_2.md` §8.2. The Python local-Python adapter mirrors
# the same logic for hosts without a Docker daemon.
FROM rocker/r-ver:4.3.3

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget curl ca-certificates build-essential \
    libcurl4-openssl-dev libssl-dev libxml2-dev \
    libhdf5-dev libz-dev libbz2-dev liblzma-dev \
    libpng-dev libjpeg-dev libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN R -e "install.packages(c('remotes','data.table','Matrix','jsonlite','dplyr','ggplot2'), repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_github('satijalab/seurat')" || \
    R -e "install.packages('Seurat', repos='https://cloud.r-project.org')"

WORKDIR /workspace
COPY wrappers/seurat_local/seurat_rna_marker_agent.R /workspace/seurat_rna_marker_agent.R
ENTRYPOINT ["Rscript", "/workspace/seurat_rna_marker_agent.R"]
