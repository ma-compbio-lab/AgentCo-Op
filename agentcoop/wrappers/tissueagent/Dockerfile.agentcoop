# Container build for the TissueAgent case-study-1 wrapper. Generated to
# match `case_study_1.md` §8.2 — uses the upstream conda environment when
# available, falls back to a plain Python install for the wrapper.
FROM mambaorg/micromamba:1.5.8

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN git clone --depth 1 --recurse-submodules https://github.com/ma-compbio/TissueAgent.git
WORKDIR /workspace/TissueAgent

# Prefer the upstream environment.yml; fall back to a minimal pip install
# if conda solving fails (the wrapper is conservative — it only needs the
# core scientific Python stack to run the headless DE analysis).
RUN micromamba create -y -n tissueagent -f environment.yml && micromamba clean -a -y \
    || (apt-get update && apt-get install -y python3 python3-pip && pip install --no-cache-dir \
        anndata scanpy scipy statsmodels pandas numpy matplotlib seaborn pydantic fastapi uvicorn)

SHELL ["micromamba", "run", "-n", "tissueagent", "/bin/bash", "-lc"]

# Editable install for TissueAgent (best-effort).
RUN pip install -e . || true

# Wrapper-only deps (stay even if upstream install fails).
RUN pip install --no-cache-dir \
    anndata scanpy scipy statsmodels pandas numpy matplotlib seaborn pydantic fastapi uvicorn pyyaml

WORKDIR /workspace
ENV OPENAI_API_KEY=
ENV AGENTCOOP_RUN_ID=case_study_1

CMD ["python", "/workspace/wrappers/tissueagent_worker.py", "--serve"]
