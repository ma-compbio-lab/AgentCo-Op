__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
runs/
!runs/.gitkeep
# Per-case-study writeups + summaries are part of the deliverable.
!runs/case1/
!runs/case2/
!runs/case3/
runs/case*/**
!runs/case*/**/
!runs/case*/**/README.md
!runs/case*/**/summary.json
!runs/case*/**/SESSION_*_NOTES.md
# Ablation deliverable — README narrative + the four §6 tables.
!runs/ablations/
!runs/ablations/README.md
!runs/ablations/*.csv
!runs/ablations/summary.json
# Wrapper data caches are lazy-fetched on first run; keep out of VCS.
agentcoop/wrappers/*/data_cache/
data/*
!data/.gitkeep
# Keep the dataset manifest for reproducibility even though the raw data is ignored.
!data/data_hashes.json
!data/README.md
# External repos (cloned for reference / image builds; commit SHAs pinned in configs/external_commits.yaml)
external/
.secrets/
docs/agents/
# Local-only paper source archive (web copy lives at assets/paper/paper.pdf).
pdf/