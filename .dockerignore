# Keep `docker build .` build context tiny — without this the daemon tars
# the entire repo (~10 GB once data/ + runs/ + external/ are populated)
# every build, even on cache hit.

# VCS / IDE
.git/
.gitignore
.dockerignore
.vscode/
.idea/

# Python virtualenvs + caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Datasets, run artifacts, external repo clones — none of these belong
# inside the runtime images. The R + Python wrappers receive their data
# via bind mounts at run time.
data/
runs/
external/

# OS / editor cruft
.DS_Store
*.swp

# Secrets — should never end up in an image layer
.secrets/
.env
